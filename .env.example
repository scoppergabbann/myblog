# Supabase
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose to client. Used only in server actions/admin routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Site URL (used for OG image absolute URLs, RSS, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin authentication (single-user). Generate random string with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string
