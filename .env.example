# =============================================================================
# Supabase
# =============================================================================
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Storage bucket name (default: bbs-images)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=bbs-images


# =============================================================================
# Site
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# =============================================================================
# NextAuth (Auth.js v5)
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-base64-secret

# In production, set this to your full site URL. Optional in dev.
# AUTH_URL=https://belutbakarsurabaya.com

# GitHub OAuth (see README for setup instructions)
AUTH_GITHUB_ID=your-github-oauth-app-client-id
AUTH_GITHUB_SECRET=your-github-oauth-app-client-secret


# =============================================================================
# Admin allowlist
# =============================================================================
# Your GitHub username (lowercase). Only this user can access /admin/*
ADMIN_GITHUB_USERNAME=your-github-username


# =============================================================================
# Anti-spam salt
# =============================================================================
# Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string
